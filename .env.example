# Copia este fichero a .env y ajusta los valores: cp .env.example .env

# Puerto publicado en tu máquina
HOST_PORT=8080
# Puerto interno del contenedor
PORT=8080

# Rutas a capturar, separadas por comas (ej: /test,/webhook)
CAPTURE_PATHS=/test
# Métodos a capturar, separados por comas, o ALL para todos
CAPTURE_METHODS=POST
# Código HTTP con el que se responde a las peticiones capturadas
RESPONSE_STATUS=200

# Número máximo de peticiones guardadas en memoria
MAX_REQUESTS=500
# Tamaño máximo del body aceptado
MAX_BODY=10mb

# Credenciales del panel /info (si INFO_PASSWORD está vacía, el panel queda sin contraseña)
INFO_USER=admin
INFO_PASSWORD=cambia-esta-clave
